# ---- EC2 (use PRIVATE IPs of your 4 instances; same file on all four) ----
JWT_SECRET=change-me-48-random-bytes
INTERNAL_KEY=change-me-another-48-random-bytes
JWT_EXPIRES=1h
MONGO_PASSWORD=change-me-db-password
MONGO_URL=mongodb://tpuser:change-me-db-password@<EC2-4-PRIVATE-IP>:27017/?authSource=admin
ADMIN_EMAIL=admin@tutorpulse.dev
ADMIN_PASSWORD=ChangeMe123
CORS_ORIGIN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Where each service lives
REGISTRATION_URL=http://<EC2-2-PRIVATE-IP>:3001
LOGIN_URL=http://<EC2-2-PRIVATE-IP>:3002
CLASSES_URL=http://<EC2-3-PRIVATE-IP>:3003
CONTENT_URL=http://<EC2-3-PRIVATE-IP>:3004
PRACTICE_URL=http://<EC2-4-PRIVATE-IP>:3005
ANALYTICS_URL=http://<EC2-4-PRIVATE-IP>:3006
# Load balancer upstreams (on EC2-1)
GATEWAY_1=gateway-1:3000
GATEWAY_2=<EC2-2-PRIVATE-IP>:3000
